{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Libreta",
  "version": "1.0.3",
  "identifier": "io.libreta.desktop",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-dist.js",
    "beforeBuildCommand": "node scripts/build-dist.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Libreta",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false,
        "useHttpsScheme": true,
        "zoomHotkeysEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost https://api.github.com https://*.supabase.co wss://*.supabase.co https://api.allorigins.win https://corsproxy.io https://api.codetabs.com https://www.youtube.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": [
        "script-src",
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-",
      "dmg": {
        "background": "branding/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "branding/installer-header.bmp",
        "sidebarImage": "branding/installer-sidebar.bmp",
        "installMode": "currentUser"
      },
      "wix": {
        "bannerPath": "branding/wix-banner.bmp",
        "dialogImagePath": "branding/wix-dialog.bmp"
      }
    },
    "category": "Productivity",
    "publisher": "Libreta",
    "copyright": "© Libreta contributors",
    "shortDescription": "A local-first personal workspace.",
    "longDescription": "Libreta is a local-first personal workspace: a block editor, databases, calendar and page hierarchy that live entirely on your computer. No account, no server, no subscription.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "libreta"
        ]
      }
    }
  }
}
